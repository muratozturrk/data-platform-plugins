# MinIO AIStor / MinIO: OpenID Connect for the console and STS AssumeRoleWithWebIdentity.
# Policy chosen from a token claim; emit a `policy` claim per platform group with a Keycloak
# mapper, or use RolePolicy (one role per client). Dell ObjectScale: verify OIDC/STS support
# of the installed version before relying on it.
MINIO_IDENTITY_OPENID_CONFIG_URL=https://sso.hkm.example/realms/hkm/.well-known/openid-configuration
MINIO_IDENTITY_OPENID_CLIENT_ID=objectstore
MINIO_IDENTITY_OPENID_CLIENT_SECRET_FILE=/run/secrets/minio-oidc/client-secret
MINIO_IDENTITY_OPENID_CLAIM_NAME=policy
MINIO_IDENTITY_OPENID_SCOPES=openid,profile
MINIO_IDENTITY_OPENID_REDIRECT_URI=https://objectstore-console.hkm.example/oauth_callback
