# Airflow 3 + apache-airflow-providers-keycloak (0.12): Keycloak Authorization Services decide
# Airflow permissions. After first deploy run, with a token of the admin client:
#   airflow keycloak-auth-manager create-permissions
#   airflow keycloak-auth-manager create-team --team t-acme      (multi-team: one team per institution)
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.keycloak.auth_manager.keycloak_auth_manager.KeycloakAuthManager
AIRFLOW__KEYCLOAK_AUTH_MANAGER__SERVER_URL=https://sso.hkm.example
AIRFLOW__KEYCLOAK_AUTH_MANAGER__REALM=hkm
AIRFLOW__KEYCLOAK_AUTH_MANAGER__CLIENT_ID=airflow
# Secret from OpenBao via ESO, mounted as a file (provider supports _CMD/_SECRET variants)
AIRFLOW__KEYCLOAK_AUTH_MANAGER__CLIENT_SECRET_CMD=cat /run/secrets/airflow-keycloak/client-secret
# Clients allowed to exchange a Keycloak token for an Airflow token (JWT bearer grant)
AIRFLOW__KEYCLOAK_AUTH_MANAGER__JWT_FEDERATED_CLIENT_IDS=svc-control-plane
AIRFLOW__API__BASE_URL=https://airflow.hkm.example
