{
  "realm": "hkm",
  "sslRequired": "all",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "registrationAllowed": false,
  "editUsernameAllowed": false,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "rememberMe": false,
  "clientScopes": [
    {
      "name": "hkm-claims",
      "protocolMappers": [
        {
          "name": "groups",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "acme-adfs",
      "providerId": "oidc",
      "trustEmail": false,
      "config": {
        "validateSignature": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "admin-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "superset",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "client-jwt",
      "redirectUris": [
        "https://superset.hkm.example/oauth-authorized/keycloak"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "https://superset.hkm.example/backchannel-logout"
      },
      "webOrigins": [
        "https://superset.hkm.example"
      ]
    },
    {
      "clientId": "kafka",
      "bearerOnly": true,
      "fullScopeAllowed": false
    },
    {
      "clientId": "svc-spark-etl",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "federated-jwt"
    }
  ],
  "passwordPolicy": "length(8) and maxLength(64) and passwordBlacklist(denylist.txt) and notUsername and notEmail",
  "otpPolicyType": "totp",
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "offlineSessionMaxLifespanEnabled": true,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0
}
