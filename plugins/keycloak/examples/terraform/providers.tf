# Terraform authenticates as a realm-local confidential client with federated
# Kubernetes service-account credentials (no static secret). The pipeline pod mounts a
# projected service-account token with audience = the realm issuer URL.
# The client needs realm-management roles (manage-realm, manage-clients, manage-users,
# view-realm, manage-identity-providers) and, since Keycloak 26.8.2, the kc-admin-api scope.
provider "keycloak" {
  url              = var.keycloak_url
  realm            = var.realm
  client_id        = "svc-terraform"
  jwt_token_file   = "/var/run/secrets/keycloak/token"
  keycloak_version = "26.8.2" # keep equal to the server image tag
}

variable "keycloak_url" {
  type    = string
  default = "https://sso.hkm.example"
}

variable "realm" {
  type    = string
  default = "hkm"
}

variable "institutions" {
  description = "Generated by examples/automation/tenant_to_tfvars.py from Tenant manifests"
  type = map(object({
    name        = string
    domains     = list(string)
    roles       = list(string)
    admin_group = string
    idp = object({
      type         = string # oidc | saml | none
      alias        = string
      issuer       = string
      metadata_url = string
      client_id    = string
      trust_email  = bool
      group_map    = map(string) # institution group name -> platform role
    })
  }))
  default = {}
}
